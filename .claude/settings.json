{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm check:unused)",
      "Bash(pnpm build)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git branch -vv)",
      "Bash(git worktree list)",
      "Bash(git merge-base *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "PowerShell(pnpm lint)",
      "PowerShell(pnpm typecheck)",
      "PowerShell(pnpm test)",
      "PowerShell(pnpm check:unused)",
      "PowerShell(pnpm build)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git worktree list)",
      "PowerShell(gh pr list *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh run list *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git stash *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(pnpm db:migrate *)",
      "Bash(pnpm db:deploy *)",
      "Bash(pnpm db:seed *)",
      "Bash(vercel *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase *)",
      "PowerShell(git stash *)",
      "PowerShell(git checkout *)",
      "PowerShell(git switch *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(pnpm db:migrate *)",
      "PowerShell(pnpm db:deploy *)",
      "PowerShell(pnpm db:seed *)",
      "PowerShell(vercel *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force *)",
      "Bash(git push * -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force-with-lease *)",
      "Bash(vercel deploy *)",
      "Bash(vercel --prod *)",
      "Bash(vercel env *)",
      "Bash(prisma migrate reset *)",
      "Bash(pnpm prisma migrate reset *)",
      "Bash(pnpm exec prisma migrate reset *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push * --force *)",
      "PowerShell(git push * -f *)",
      "PowerShell(git push --force-with-lease *)",
      "PowerShell(git push * --force-with-lease *)",
      "PowerShell(vercel deploy *)",
      "PowerShell(vercel --prod *)",
      "PowerShell(vercel env *)",
      "PowerShell(prisma migrate reset *)",
      "PowerShell(pnpm prisma migrate reset *)",
      "PowerShell(pnpm exec prisma migrate reset *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/proteger-secretos.mjs\""
          }
        ]
      }
    ]
  }
}
