    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "setup:admin": "tsx scripts/setup-admin.ts",
    "admin": "tsx scripts/admin.ts",
    "postinstall": "prisma generate",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "mobile:sync": "cap sync",
    "mobile:assets": "node scripts/mobile-assets.mjs",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "mobile:apk": "cap sync android && cd android && gradlew assembleDebug",
    "check:unused": "knip",
    "brand:dove": "node scripts/brand-dove.mjs",
