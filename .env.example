# Copia este archivo a .env y reemplaza los valores. NUNCA subas .env a git.

# PostgreSQL
DATABASE_URL="postgresql://iglesia:cambiar-esto@localhost:5432/iglesia_dev?schema=public"
# Base exclusiva para pruebas automatizadas (su nombre debe contener "test"; se vacía en cada ejecución)
TEST_DATABASE_URL="postgresql://iglesia:cambiar-esto@localhost:5432/iglesia_test?schema=public"

# Better Auth — genera un valor aleatorio, por ejemplo: openssl rand -base64 32
BETTER_AUTH_SECRET="reemplazar-con-valor-aleatorio"
BETTER_AUTH_URL="http://localhost:3000"

# Encabezado con la IP real del cliente, SOLO si un proxy confiable lo fija (p. ej. "x-forwarded-for"
# en Railway/Vercel). Vacío en desarrollo local. Lista separada por comas.
AUTH_IP_HEADERS=""
# IPs/CIDR de los proxies confiables cuando el encabezado trae una cadena de IPs (opcional).
AUTH_TRUSTED_PROXIES=""

# Zona horaria por defecto (se puede cambiar desde Configuración)
DEFAULT_TIMEZONE="America/Mexico_City"

# Correo saliente (fase posterior). En desarrollo los enlaces de recuperación se imprimen en consola.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# MAIL_FROM=""
